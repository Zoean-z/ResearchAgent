# Copy this file to `.env` and fill in the local values you want to use.
# This template is set up for the model-enabled local development path.

# Storage
RESEARCH_AGENT_STORAGE_BACKEND=sqlite
RESEARCH_AGENT_SQLITE_PATH=data/sqlite/research_agent.sqlite3

# Query planner
# Use `heuristic` or `model_adapter`.
# `model_adapter` now attempts a real provider transport and falls back to heuristic on
# missing credentials, transport errors, invalid JSON, or invalid tool choices.
RESEARCH_AGENT_QUERY_PLANNER_BACKEND=model_adapter
RESEARCH_AGENT_QUERY_PLANNER_PROVIDER=deepseek
RESEARCH_AGENT_QUERY_PLANNER_MODEL=deepseek-v4-flash
RESEARCH_AGENT_QUERY_PLANNER_BASE_URL=https://api.deepseek.com
RESEARCH_AGENT_QUERY_PLANNER_TIMEOUT_SECONDS=30

# Query orchestration backend
RESEARCH_AGENT_QUERY_AGENT_BACKEND=turn_adapter
RESEARCH_AGENT_QUERY_AGENT_PROVIDER=deepseek
RESEARCH_AGENT_QUERY_AGENT_MODEL=deepseek-v4-flash
RESEARCH_AGENT_QUERY_AGENT_BASE_URL=https://api.deepseek.com
RESEARCH_AGENT_QUERY_AGENT_TIMEOUT_SECONDS=30

# Ingest extraction backend
# Use `heuristic` or `model_adapter`.
RESEARCH_AGENT_INGEST_EXTRACTION_BACKEND=model_adapter
RESEARCH_AGENT_INGEST_EXTRACTION_PROVIDER=deepseek
RESEARCH_AGENT_INGEST_EXTRACTION_MODEL=deepseek-v4-flash
RESEARCH_AGENT_INGEST_EXTRACTION_BASE_URL=https://api.deepseek.com
RESEARCH_AGENT_INGEST_EXTRACTION_TIMEOUT_SECONDS=30

# Provider credentials
DEEPSEEK_API_KEY=replace_with_your_key

# Optional OpenViking bridge for accepted intake messages, mirrored memories, and retrieval hints
# Use `noop` to disable, `inmemory` for the shared local test double, `embedded` for a local
# library-backed OpenViking path, or `mirror` / `sdk` to try the SDK-backed best-effort
# OpenViking surface bundle.
RESEARCH_AGENT_OPENVIKING_BACKEND=embedded
RESEARCH_AGENT_OPENVIKING_DATA_PATH=data/openviking
OPENVIKING_CONFIG_FILE=data/openviking/ov.conf
RESEARCH_AGENT_OPENVIKING_URL=http://127.0.0.1:1933
RESEARCH_AGENT_OPENVIKING_API_KEY=
RESEARCH_AGENT_OPENVIKING_AGENT_ID=research-agent
